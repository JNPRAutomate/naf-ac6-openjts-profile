      "targets": [
        {
          "query": "SELECT last(\"if_mtu\") AS \"x\" FROM \"INTERFACES\" WHERE \"SHORTNAME\" =~ /^$device$/ AND $timeFilter GROUP BY \"SHORTNAME\", \"device\", \"FAMILY\", \"VERSION\"",
