    {
      "datasource": {
        "type": "influxdb",
        "uid": "jtsuid"
      },
      "description": "cRPD: sum of cpu-utilization of long-running processes (gNMI /system/processes). Short-lived helpers (ifinfo, python3, ps, sh) are excluded because they report CPU relative to their own lifetime. cSRX: SPU CPU from 'show security monitoring' (data plane).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 25,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "query": "SELECT sum(\"c\") FROM (SELECT mean(\"process_cpu_utilization\") AS \"c\" FROM \"SYSTEM\" WHERE \"SHORTNAME\" =~ /^$device$/ AND \"process_name\" !~ /^(ifinfo|python3|ps|sh)$/ AND $timeFilter GROUP BY time($__interval), \"SHORTNAME\", \"process_name\") WHERE $timeFilter GROUP BY time($__interval), \"SHORTNAME\" fill(none)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series",
          "alias": "$tag_SHORTNAME"
        },
        {
          "alias": "$tag_SHORTNAME (SPU)",
          "query": "SELECT mean(\"spu_cpu_pct\") FROM \"SECURITY_SPU\" WHERE \"SHORTNAME\" =~ /^$device$/ AND $timeFilter GROUP BY time($__interval), \"SHORTNAME\" fill(none)",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "time_series"
        }
      ],
      "title": "CPU total",
      "type": "timeseries"
    },
