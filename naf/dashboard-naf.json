      "targets": [
        {
          "query": "SELECT last(\"mem_active_kb\") / last(\"mem_total_kb\") * 100 FROM \"SYSTEM_MEMORY\" WHERE \"SHORTNAME\" =~ /^$device$/ AND $timeFilter GROUP BY \"SHORTNAME\"",
