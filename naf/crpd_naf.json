  "monitoring_list": [
    {
      "order": 600,
      "namepass": [
        "INTERFACES"
      ],
      "probes": [
        {
          "name": "ETH_DROP_IN",
          "field": "in_errors_rate",
          "type": "current",
          "threshold": 1,
          "operator": "gt",
          "tags": [
            "device",
            "SHORTNAME",
            "if_name",
            "LINKNAME"
          ]
        },
        {
          "name": "ETH_DROP_OUT",
          "field": "out_errors_rate",
          "type": "current",
          "threshold": 1,
          "operator": "gt",
          "tags": [
            "device",
            "SHORTNAME",
            "if_name",
            "LINKNAME"
          ]
        }
      ]
    }
  ],
