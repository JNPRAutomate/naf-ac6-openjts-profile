  "filtering_list": [
    {
      "order": 150,
      "namepass": [
        "INTERFACES"
      ],
      "filters": [
        {
          "type": 0,
          "key": "if_name",
          "pattern": "^(eth|lo).*",
          "action": "accept"
        }
      ]
    },
    {
      "order": 150,
      "namepass": [
        "SYSTEM_STORAGE"
      ],
      "filters": [
        {
          "type": 0,
          "key": "mount_point",
          "pattern": "^/$",
          "action": "accept"
        }
      ]
    }
  ],
  "enrichment_list": [
    {
      "order": 200,
      "namepass": [
        "NETWORK_INSTANCE_BGP"
      ],
      "family": "crpd",
      "two_levels": false,
      "level1_tag": "device"
