  "regex_list": [
    {
      "order": 300,
      "namepass": [
        "NETWORK_INSTANCE_BGP"
      ],
      "entries": [
        {
          "type": 1,
          "pattern": ".*prefix-limit-received.state.(max-prefixes)",
          "replacement": "${1}"
        }
      ]
    },
    {
      "order": 310,
      "namepass": [
        "SYSTEM"
      ],
      "entries": [
        {
          "type": 2,
          "key": "process_pid",
          "pattern": "^.*$",
          "replacement": "all"
        }
      ]
    }
  ],
  "strings_list": [
    {
      "order": 400,
      "namepass": [
        "INTERFACES"
